# Copy to .env.local and fill in. Never commit real values.

# NextAuth session signing secret.
# Generate a real one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# The base URL the app is served from. Must match the port you run on,
# or sign-in will redirect to a dead address.
NEXTAUTH_URL="http://localhost:3000"

# OpenAI key — used by src/lib/youtube.js to generate quizzes from video.
# Quiz generation is skipped without it; the rest of the app runs fine.
OPENAI_API_KEY=""
