# Copy to .env and fill in. Never commit real values — .env is gitignored.
#
# Use .env rather than .env.local: the Prisma CLI reads .env only, and Next
# reads it too, so one file covers both. A DATABASE_URL that lives only in
# .env.local will work in the app and fail every `prisma migrate` command.

# PostgreSQL connection string. Neon, Supabase, or any hosted Postgres.
# Neon gives you this on the project dashboard; use the pooled connection
# string for serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth session signing secret.
# Generate a real one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# The base URL the app is served from. Must match the port you run on, or
# sign-in redirects to a dead address. In production this is your domain.
NEXTAUTH_URL="http://localhost:3000"

# OpenAI key — used by src/lib/youtube.js to generate quizzes from video.
# Optional: without it the lesson still renders and simply has no quiz.
OPENAI_API_KEY=""
