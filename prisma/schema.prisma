// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  progress     Progress[]
  UserProgress UserProgress[]
}

model Module {
  id             String         @id @default(cuid())
  title          String
  description    String
  estimatedHours Int
  order          Int
  published      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lessons        Lesson[]
  progress       Progress[]
  UserProgress   UserProgress[]
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String
  // Lesson body text. Kept separate from videoUrl: a lesson can be text-only.
  content     String
  // YouTube URL for the lesson video. Optional — a lesson without one simply
  // renders no player. Both API routes and the lesson page already read and
  // wrote this field; it was missing from the model, so lesson.videoUrl was
  // always undefined and every lesson reported "Invalid YouTube URL".
  videoUrl    String?
  duration    Int
  order       Int
  published   Boolean    @default(true)
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  progress  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}
